size = Vector2(300, 200)
lines_easy = PackedStringArray("Esse é um item de vida: encoste nele para recuperar um coração. Se sua vida já estiver cheia, ele fica esperando por você.")
lines_medium = PackedStringArray("Item de vida: recupera um coração.")

[node name="DicaPorta" parent="." instance=ExtResource("32_dnt")]
position = Vector2(-1000, 2850)
