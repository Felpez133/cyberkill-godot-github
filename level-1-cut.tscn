position = Vector2(397, 540)
narration_id = "dif_cut_inicio"
size = Vector2(500, 300)
lines_easy = PackedStringArray("Bem-vindo à Fase 1, Biker. No modo FÁCIL o mapa é menor e eu vou te mostrar o caminho.", "As setas azuis indicam para onde ir. Itens verdes com cruz recuperam vida, e as placas coloridas são checkpoints: se você morrer, volta para a última que ativou.")
