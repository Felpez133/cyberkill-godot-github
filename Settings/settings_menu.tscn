[gd_scene format=3]

[ext_resource type="Script" path="res://Settings/settings_menu.gd" id="1_script"]

[node name="SettingsMenu" type="CanvasLayer"]
process_mode = 3
layer = 80
script = ExtResource("1_script")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.01, 0.05, 0.88)

[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Root/Center"]
custom_minimum_size = Vector2(640, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Root/Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="Root/Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Root/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 0.9, 1, 1)
theme_override_font_sizes/font_size = 32
text = "CONFIGURAÇÕES"
horizontal_alignment = 1

[node name="MasterRow" type="HBoxContainer" parent="Root/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Label" type="Label" parent="Root/Center/Panel/Margin/VBox/MasterRow"]
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Volume geral"

[node name="MasterSlider" type="HSlider" parent="Root/Center/Panel/Margin/VBox/MasterRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
step = 1.0
value = 100.0

[node name="MasterSpin" type="SpinBox" parent="Root/Center/Panel/Margin/VBox/MasterRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
value = 100.0
suffix = "%"

[node name="MusicRow" type="HBoxContainer" parent="Root/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Label" type="Label" parent="Root/Center/Panel/Margin/VBox/MusicRow"]
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Música"

[node name="MusicSlider" type="HSlider" parent="Root/Center/Panel/Margin/VBox/MusicRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
step = 1.0
value = 100.0

[node name="MusicSpin" type="SpinBox" parent="Root/Center/Panel/Margin/VBox/MusicRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
value = 100.0
suffix = "%"

[node name="Separator" type="HSeparator" parent="Root/Center/Panel/Margin/VBox"]
layout_mode = 2

[node name="CheatsLabel" type="Label" parent="Root/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Cheats"

[node name="CheatRow" type="HBoxContainer" parent="Root/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="CheatInput" type="LineEdit" parent="Root/Center/Panel/Margin/VBox/CheatRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "digite um código e aperte Enter"

[node name="CheatApply" type="Button" parent="Root/Center/Panel/Margin/VBox/CheatRow"]
unique_name_in_owner = true
layout_mode = 2
text = "APLICAR"

[node name="CheatStatus" type="Label" parent="Root/Center/Panel/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.25, 1)
text = "Cheats ativos: nenhum"
autowrap_mode = 3

[node name="BackButton" type="Button" parent="Root/Center/Panel/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "VOLTAR"
